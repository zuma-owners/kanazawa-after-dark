---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/articles/', label: 'Articles' },
	{ href: '/guide/', label: 'Guide' },
	{ href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M14.5 2.5a9.5 9.5 0 1 0 7 15.9A8 8 0 0 1 14.5 2.5Z" /></svg>
			<span>{SITE_TITLE}</span>
		</a>
		<nav aria-label="Main">
			{
				links.map((l) => (
					<a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		position: sticky;
		top: 0;
		z-index: 10;
		backdrop-filter: blur(6px);
	}
	.wrap {
		max-width: var(--max);
		margin: 0 auto;
		padding: 0.6rem var(--gutter);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--text);
		text-decoration: none;
		font-family: var(--serif);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.brand svg {
		color: var(--accent);
	}
	nav {
		display: flex;
		gap: 0.25rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
		background: var(--surface);
	}
</style>
