---
import type { Article } from '../lib/articles';
import { areaBySlug } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	place: NonNullable<Article['data']['place']>;
	area?: string;
}
const { place, area } = Astro.props;
const areaName = areaBySlug(area);
const rows: [string, string | undefined][] = [
	['Name', place.nameJa ? `${place.name} (${place.nameJa})` : place.name],
	['Area', areaName ? `${areaName.name} (${areaName.ja})` : undefined],
	['Address', place.address],
	['Access', place.access],
	['Price range', place.priceRange],
	['Payment', place.payment],
	['Hours', place.hours],
	['Closed', place.closed],
];
---

<section class="practical" aria-labelledby="practical-info">
	<h2 id="practical-info">Practical info</h2>
	<div class="table-wrap">
		<table>
			<tbody>
				{
					rows
						.filter(([, v]) => v)
						.map(([k, v]) => (
							<tr>
								<th scope="row">{k}</th>
								<td>{v}</td>
							</tr>
						))
				}
				{
					place.website && (
						<tr>
							<th scope="row">Official</th>
							<td>
								<a href={place.website} rel="noopener" target="_blank">
									{new URL(place.website).hostname.replace(/^www\./, '')}
								</a>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>
	<p class="small muted note">
		{
			place.verified ? (
				<>
					Address and hours checked online
					{place.checkedDate && (
						<>
							{' '}
							on <FormattedDate date={place.checkedDate} />
						</>
					)}
					. Hours in Japan change often, so it is worth checking before you go.
				</>
			) : (
				<>Items marked (unverified) could not be confirmed online yet. Please check before you go.</>
			)
		}
	</p>
</section>

<style>
	.practical {
		margin-top: 2.5rem;
	}
	.table-wrap {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 10px;
		overflow: hidden;
	}
	tr:last-child th,
	tr:last-child td {
		border-bottom: 0;
	}
	th {
		width: 7.5rem;
	}
	.note {
		margin-top: 0.6rem;
	}
</style>
